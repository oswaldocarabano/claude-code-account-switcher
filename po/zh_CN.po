msgid "Could not read %s: %s"
msgstr "无法读取 %s：%s"

msgid "Too many symbolic links: %s"
msgstr "符号链接过多：%s"

msgid "Tried to write an invalid number to JSON"
msgstr "试图向 JSON 写入无效数字"

msgid "Could not write %s: %s"
msgstr "无法写入 %s：%s"

msgid "Could not create %s"
msgstr "无法创建 %s"

msgid "Could not move %s: %s"
msgstr "无法移动 %s：%s"

msgid "Could not create the lock %s: %s"
msgstr "无法创建锁 %s：%s"

msgid "The lock %s is still held: Claude Code or another process is writing. Try again in a few seconds."
msgstr "锁 %s 仍被占用：Claude Code 或其他进程正在写入。请几秒后重试。"

msgid "registry.json is damaged; it is left untouched. Check it by hand."
msgstr "registry.json 已损坏，未做修改。请手动检查。"

msgid "registry.json has an unknown version (%s)."
msgstr "registry.json 的版本未知（%s）。"

msgid "No accounts yet. Use: claude-accounts add --current"
msgstr "还没有账户。请使用：claude-accounts add --current"

msgid "Active account: %s"
msgstr "当前账户：%s"

msgid "Not switched (%s)."
msgstr "未切换（%s）。"

msgid "warning"
msgstr "警告"

msgid "Name the account: claude-accounts switch <n|email|alias> or --best"
msgstr "请指定账户：claude-accounts switch <编号|邮箱|别名> 或 --best"

msgid "Open in your browser: %s"
msgstr "请在浏览器中打开：%s"

msgid "Unknown command: %s. Use: claude-accounts help"
msgstr "未知命令：%s。请使用：claude-accounts help"

msgid "Claude Code is not signed in."
msgstr "Claude Code 未登录。"

msgid "The current Claude Code session has no tokens: sign in again."
msgstr "当前 Claude Code 会话没有令牌：请重新登录。"

msgid "oauthAccount was not found in the Claude Code configuration."
msgstr "在 Claude Code 配置中找不到 oauthAccount。"

msgid "Claude Code (claude) was not found."
msgstr "找不到 Claude Code（claude）。"

msgid "Could not start claude: %s"
msgstr "无法启动 claude：%s"

msgid "Sign-in took too long."
msgstr "登录耗时过长。"

msgid "Sign-in cancelled."
msgstr "登录已取消。"

msgid "Claude Code did not complete the sign-in."
msgstr "Claude Code 未完成登录。"

msgid "The sign-in did not leave a valid credential."
msgstr "登录后没有留下有效凭据。"

msgid "The current session does not match its saved account; a backup was saved and no account was touched."
msgstr "当前会话与其保存的账户不匹配；已保存备份，未改动任何账户。"

msgid "The current session belongs to an account Claude Account Switcher does not know; a backup was saved."
msgstr "当前会话属于 Claude Account Switcher 不认识的账户；已保存备份。"

msgid "The latest copy of the active account could not be confirmed (offline); the previous one was backed up."
msgstr "无法确认当前账户的最新副本（离线）；已备份上一份。"

msgid "Claude Code lost the session of the active account: sign in again."
msgstr "Claude Code 丢失了当前账户的会话：请重新登录。"

msgid "There is no account “%s”."
msgstr "账户“%s”不存在。"

msgid "The active account cannot be removed. Switch to another one first."
msgstr "无法移除当前账户。请先切换到其他账户。"

msgid "An alias cannot be just a number."
msgstr "别名不能只是数字。"

msgid "The alias “%s” is already in use."
msgstr "别名“%s”已被使用。"

msgid "The server rejected the OAuth client; the official CLI will be used to renew."
msgstr "服务器拒绝了 OAuth 客户端；将使用官方 CLI 续期。"

msgid "Account %d (%s) needs to sign in again."
msgstr "账户 %d（%s）需要重新登录。"

msgid "The copy of account %d has no tokens."
msgstr "账户 %d 的副本没有令牌。"

msgid "Account %d has no saved oauthAccount."
msgstr "账户 %d 没有保存的 oauthAccount。"

msgid "Could not switch account; the previous state was restored (%s)."
msgstr "无法切换账户；已恢复之前的状态（%s）。"

msgid "Could not switch account nor restore the previous state (%s). Backups are in stash/."
msgstr "无法切换账户，也无法恢复之前的状态（%s）。备份在 stash/ 中。"

msgid "Claude Code still reports another account. Check with /status."
msgstr "Claude Code 仍显示另一个账户。请用 /status 检查。"

msgid "Claude Code keeps renewing its credentials; try again in a few seconds."
msgstr "Claude Code 不断续期凭据；请几秒后重试。"

