msgid "Could not read %s: %s"
msgstr "No se pudo leer %s: %s"

msgid "Too many symbolic links: %s"
msgstr "Demasiados enlaces simbólicos: %s"

msgid "Tried to write an invalid number to JSON"
msgstr "Se intentó escribir un número no válido en JSON"

msgid "Could not write %s: %s"
msgstr "No se pudo escribir %s: %s"

msgid "Could not create %s"
msgstr "No se pudo crear %s"

msgid "Could not move %s: %s"
msgstr "No se pudo mover %s: %s"

msgid "Could not create the lock %s: %s"
msgstr "No se pudo crear el bloqueo %s: %s"

msgid "The lock %s is still held: Claude Code or another process is writing. Try again in a few seconds."
msgstr "El bloqueo %s sigue ocupado: Claude Code u otro proceso está escribiendo. Reintenta en unos segundos."

msgid "registry.json is damaged; it is left untouched. Check it by hand."
msgstr "registry.json está dañado; no se modifica. Revísalo a mano."

msgid "registry.json has an unknown version (%s)."
msgstr "registry.json tiene una versión desconocida (%s)."

msgid "No accounts yet. Use: claude-accounts add --current"
msgstr "Todavía no hay cuentas. Usa: claude-accounts add --current"

msgid "Active account: %s"
msgstr "Cuenta activa: %s"

msgid "Not switched (%s)."
msgstr "No se cambió (%s)."

msgid "warning"
msgstr "aviso"

msgid "Name the account: claude-accounts switch <n|email|alias> or --best"
msgstr "Indica la cuenta: claude-accounts switch <n|correo|alias> o --best"

msgid "Open in your browser: %s"
msgstr "Abre en el navegador: %s"

msgid "Unknown command: %s. Use: claude-accounts help"
msgstr "Orden desconocida: %s. Usa: claude-accounts help"

msgid "Claude Code is not signed in."
msgstr "Claude Code no tiene ninguna sesión iniciada."

msgid "The current Claude Code session has no tokens: sign in again."
msgstr "La sesión actual de Claude Code no tiene tokens: inicia sesión otra vez."

msgid "oauthAccount was not found in the Claude Code configuration."
msgstr "No se encontró oauthAccount en la configuración de Claude Code."

msgid "Claude Code (claude) was not found."
msgstr "No se encontró Claude Code (claude)."

msgid "Could not start claude: %s"
msgstr "No se pudo lanzar claude: %s"

msgid "Sign-in took too long."
msgstr "El inicio de sesión tardó demasiado."

msgid "Sign-in cancelled."
msgstr "Inicio de sesión cancelado."

msgid "Claude Code did not complete the sign-in."
msgstr "Claude Code no completó el inicio de sesión."

msgid "The sign-in did not leave a valid credential."
msgstr "El inicio de sesión no dejó una credencial válida."

msgid "The current session does not match its saved account; a backup was saved and no account was touched."
msgstr "La sesión actual no coincide con su cuenta guardada; se guardó un respaldo y no se tocó ninguna cuenta."

msgid "The current session belongs to an account Claude Account Switcher does not know; a backup was saved."
msgstr "La sesión actual es de una cuenta que Claude Account Switcher no conoce; se guardó un respaldo."

msgid "The latest copy of the active account could not be confirmed (offline); the previous one was backed up."
msgstr "No se pudo confirmar la última copia de la cuenta activa (sin red); la anterior quedó respaldada."

msgid "Claude Code lost the session of the active account: sign in again."
msgstr "Claude Code perdió la sesión de la cuenta activa: inicia sesión otra vez."

msgid "There is no account “%s”."
msgstr "No existe la cuenta «%s»."

msgid "The active account cannot be removed. Switch to another one first."
msgstr "No se puede quitar la cuenta activa. Cambia antes a otra."

msgid "An alias cannot be just a number."
msgstr "Un alias no puede ser solo un número."

msgid "The alias “%s” is already in use."
msgstr "El alias «%s» ya está en uso."

msgid "The server rejected the OAuth client; the official CLI will be used to renew."
msgstr "El servidor rechazó el cliente OAuth; se usará la CLI oficial para renovar."

msgid "Account %d (%s) needs to sign in again."
msgstr "La cuenta %d (%s) necesita iniciar sesión otra vez."

msgid "The copy of account %d has no tokens."
msgstr "La copia de la cuenta %d no tiene tokens."

msgid "Account %d has no saved oauthAccount."
msgstr "La cuenta %d no tiene oauthAccount guardado."

msgid "Could not switch account; the previous state was restored (%s)."
msgstr "No se pudo cambiar de cuenta; se restauró el estado anterior (%s)."

msgid "Could not switch account nor restore the previous state (%s). Backups are in stash/."
msgstr "No se pudo cambiar de cuenta ni restaurar el estado anterior (%s). Hay respaldos en stash/."

msgid "Claude Code still reports another account. Check with /status."
msgstr "Claude Code aún informa otra cuenta. Revisa con /status."

msgid "Claude Code keeps renewing its credentials; try again in a few seconds."
msgstr "Claude Code renueva sus credenciales sin parar; reintenta en unos segundos."

msgid "resets at %s"
msgstr "se reinicia a las %s"

