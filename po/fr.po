msgid "Could not read %s: %s"
msgstr "Impossible de lire %s : %s"

msgid "Too many symbolic links: %s"
msgstr "Trop de liens symboliques : %s"

msgid "Tried to write an invalid number to JSON"
msgstr "Tentative d’écrire un nombre invalide en JSON"

msgid "Could not write %s: %s"
msgstr "Impossible d’écrire %s : %s"

msgid "Could not create %s"
msgstr "Impossible de créer %s"

msgid "Could not move %s: %s"
msgstr "Impossible de déplacer %s : %s"

msgid "Could not create the lock %s: %s"
msgstr "Impossible de créer le verrou %s : %s"

msgid "The lock %s is still held: Claude Code or another process is writing. Try again in a few seconds."
msgstr "Le verrou %s est toujours pris : Claude Code ou un autre processus écrit. Réessayez dans quelques secondes."

msgid "registry.json is damaged; it is left untouched. Check it by hand."
msgstr "registry.json est endommagé ; il n’est pas modifié. Vérifiez-le à la main."

msgid "registry.json has an unknown version (%s)."
msgstr "registry.json a une version inconnue (%s)."

msgid "No accounts yet. Use: claude-accounts add --current"
msgstr "Aucun compte pour l’instant. Utilisez : claude-accounts add --current"

msgid "Active account: %s"
msgstr "Compte actif : %s"

msgid "Not switched (%s)."
msgstr "Pas de changement (%s)."

msgid "warning"
msgstr "avertissement"

msgid "Name the account: claude-accounts switch <n|email|alias> or --best"
msgstr "Indiquez le compte : claude-accounts switch <n|e-mail|alias> ou --best"

msgid "Open in your browser: %s"
msgstr "Ouvrez dans votre navigateur : %s"

msgid "Unknown command: %s. Use: claude-accounts help"
msgstr "Commande inconnue : %s. Utilisez : claude-accounts help"

msgid "Claude Code is not signed in."
msgstr "Claude Code n’a aucune session ouverte."

msgid "The current Claude Code session has no tokens: sign in again."
msgstr "La session actuelle de Claude Code n’a pas de jetons : reconnectez-vous."

msgid "oauthAccount was not found in the Claude Code configuration."
msgstr "oauthAccount introuvable dans la configuration de Claude Code."

msgid "Claude Code (claude) was not found."
msgstr "Claude Code (claude) introuvable."

msgid "Could not start claude: %s"
msgstr "Impossible de lancer claude : %s"

msgid "Sign-in took too long."
msgstr "La connexion a pris trop de temps."

msgid "Sign-in cancelled."
msgstr "Connexion annulée."

msgid "Claude Code did not complete the sign-in."
msgstr "Claude Code n’a pas terminé la connexion."

msgid "The sign-in did not leave a valid credential."
msgstr "La connexion n’a pas laissé d’identifiants valides."

msgid "The current session does not match its saved account; a backup was saved and no account was touched."
msgstr "La session actuelle ne correspond pas à son compte enregistré ; une sauvegarde a été faite et aucun compte n’a été modifié."

msgid "The current session belongs to an account Claude Account Switcher does not know; a backup was saved."
msgstr "La session actuelle appartient à un compte inconnu de Claude Account Switcher ; une sauvegarde a été faite."

msgid "The latest copy of the active account could not be confirmed (offline); the previous one was backed up."
msgstr "La dernière copie du compte actif n’a pas pu être confirmée (hors ligne) ; la précédente a été sauvegardée."

msgid "Claude Code lost the session of the active account: sign in again."
msgstr "Claude Code a perdu la session du compte actif : reconnectez-vous."

msgid "There is no account “%s”."
msgstr "Le compte « %s » n’existe pas."

msgid "The active account cannot be removed. Switch to another one first."
msgstr "Le compte actif ne peut pas être retiré. Passez d’abord à un autre."

msgid "An alias cannot be just a number."
msgstr "Un alias ne peut pas être uniquement un nombre."

msgid "The alias “%s” is already in use."
msgstr "L’alias « %s » est déjà utilisé."

msgid "The server rejected the OAuth client; the official CLI will be used to renew."
msgstr "Le serveur a refusé le client OAuth ; la CLI officielle sera utilisée pour renouveler."

msgid "Account %d (%s) needs to sign in again."
msgstr "Le compte %d (%s) doit se reconnecter."

msgid "The copy of account %d has no tokens."
msgstr "La copie du compte %d n’a pas de jetons."

msgid "Account %d has no saved oauthAccount."
msgstr "Le compte %d n’a pas d’oauthAccount enregistré."

msgid "Could not switch account; the previous state was restored (%s)."
msgstr "Impossible de changer de compte ; l’état précédent a été restauré (%s)."

msgid "Could not switch account nor restore the previous state (%s). Backups are in stash/."
msgstr "Impossible de changer de compte ou de restaurer l’état précédent (%s). Des sauvegardes sont dans stash/."

msgid "Claude Code still reports another account. Check with /status."
msgstr "Claude Code indique toujours un autre compte. Vérifiez avec /status."

msgid "Claude Code keeps renewing its credentials; try again in a few seconds."
msgstr "Claude Code renouvelle sans cesse ses identifiants ; réessayez dans quelques secondes."

