# Hindi translation of Claude Code Account Switcher.
msgid ""
msgstr ""
"Language: hi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Could not read %s: %s"
msgstr "%s पढ़ा नहीं जा सका: %s"

msgid "Too many symbolic links: %s"
msgstr "बहुत अधिक सिम्बॉलिक लिंक: %s"

msgid "Tried to write an invalid number to JSON"
msgstr "JSON में अमान्य संख्या लिखने का प्रयास हुआ"

msgid "Could not write %s: %s"
msgstr "%s लिखा नहीं जा सका: %s"

msgid "Could not create %s"
msgstr "%s बनाया नहीं जा सका"

msgid "Could not move %s: %s"
msgstr "%s ले जाया नहीं जा सका: %s"

msgid "Could not create the lock %s: %s"
msgstr "लॉक %s बनाया नहीं जा सका: %s"

msgid "The lock %s is still held: Claude Code or another process is writing. Try again in a few seconds."
msgstr "लॉक %s अभी भी व्यस्त है: Claude Code या कोई अन्य प्रक्रिया लिख रही है। कुछ सेकंड बाद फिर कोशिश करें।"

msgid "registry.json is damaged; it is left untouched. Check it by hand."
msgstr "registry.json खराब है; इसे बदला नहीं गया। इसे हाथ से जाँचें।"

msgid "registry.json has an unknown version (%s)."
msgstr "registry.json का संस्करण अज्ञात है (%s)।"

msgid "No accounts yet. Use: claude-accounts add --current"
msgstr "अभी कोई खाता नहीं है। उपयोग करें: claude-accounts add --current"

msgid "Active account: %s"
msgstr "सक्रिय खाता: %s"

msgid "Not switched (%s)."
msgstr "नहीं बदला गया (%s)।"

msgid "warning"
msgstr "चेतावनी"

msgid "Name the account: claude-accounts switch <n|email|alias> or --best"
msgstr "खाता बताएँ: claude-accounts switch <n|ईमेल|उपनाम> या --best"

msgid "Open in your browser: %s"
msgstr "अपने ब्राउज़र में खोलें: %s"

msgid "Unknown command: %s. Use: claude-accounts help"
msgstr "अज्ञात कमांड: %s। उपयोग करें: claude-accounts help"

msgid "Claude Code is not signed in."
msgstr "Claude Code में कोई सत्र साइन इन नहीं है।"

msgid "The current Claude Code session has no tokens: sign in again."
msgstr "वर्तमान Claude Code सत्र में टोकन नहीं हैं: फिर से साइन इन करें।"

msgid "oauthAccount was not found in the Claude Code configuration."
msgstr "Claude Code कॉन्फ़िगरेशन में oauthAccount नहीं मिला।"

msgid "Claude Code (claude) was not found."
msgstr "Claude Code (claude) नहीं मिला।"

msgid "Could not start claude: %s"
msgstr "claude शुरू नहीं हो सका: %s"

msgid "Sign-in took too long."
msgstr "साइन इन में बहुत समय लगा।"

msgid "Sign-in cancelled."
msgstr "साइन इन रद्द किया गया।"

msgid "Claude Code did not complete the sign-in."
msgstr "Claude Code ने साइन इन पूरा नहीं किया।"

msgid "The sign-in did not leave a valid credential."
msgstr "साइन इन के बाद कोई मान्य क्रेडेंशियल नहीं मिला।"

msgid "The current session does not match its saved account; a backup was saved and no account was touched."
msgstr "वर्तमान सत्र अपने सहेजे गए खाते से मेल नहीं खाता; बैकअप सहेजा गया और किसी खाते को छुआ नहीं गया।"

msgid "The current session belongs to an account Claude Account Switcher does not know; a backup was saved."
msgstr "वर्तमान सत्र ऐसे खाते का है जिसे Claude Account Switcher नहीं जानता; बैकअप सहेजा गया।"

msgid "The latest copy of the active account could not be confirmed (offline); the previous one was backed up."
msgstr "सक्रिय खाते की नवीनतम प्रति की पुष्टि नहीं हो सकी (ऑफ़लाइन); पिछली प्रति का बैकअप लिया गया।"

msgid "Claude Code lost the session of the active account: sign in again."
msgstr "Claude Code ने सक्रिय खाते का सत्र खो दिया: फिर से साइन इन करें।"

msgid "There is no account “%s”."
msgstr "खाता “%s” मौजूद नहीं है।"

msgid "The active account cannot be removed. Switch to another one first."
msgstr "सक्रिय खाता हटाया नहीं जा सकता। पहले किसी दूसरे खाते पर जाएँ।"

msgid "An alias cannot be just a number."
msgstr "उपनाम केवल एक संख्या नहीं हो सकता।"

msgid "The alias “%s” is already in use."
msgstr "उपनाम “%s” पहले से उपयोग में है।"

msgid "The server rejected the OAuth client; the official CLI will be used to renew."
msgstr "सर्वर ने OAuth क्लाइंट अस्वीकार कर दिया; नवीनीकरण के लिए आधिकारिक CLI का उपयोग होगा।"

msgid "Account %d (%s) needs to sign in again."
msgstr "खाता %d (%s) को फिर से साइन इन करना होगा।"

msgid "The copy of account %d has no tokens."
msgstr "खाता %d की प्रति में टोकन नहीं हैं।"

msgid "Account %d has no saved oauthAccount."
msgstr "खाता %d का oauthAccount सहेजा नहीं गया है।"

msgid "Could not switch account; the previous state was restored (%s)."
msgstr "खाता नहीं बदला जा सका; पिछली स्थिति बहाल की गई (%s)।"

msgid "Could not switch account nor restore the previous state (%s). Backups are in stash/."
msgstr "खाता नहीं बदला जा सका और पिछली स्थिति भी बहाल नहीं हुई (%s)। बैकअप stash/ में हैं।"

msgid "Claude Code still reports another account. Check with /status."
msgstr "Claude Code अभी भी दूसरा खाता दिखा रहा है। /status से जाँचें।"

msgid "Claude Code keeps renewing its credentials; try again in a few seconds."
msgstr "Claude Code लगातार क्रेडेंशियल नवीनीकृत कर रहा है; कुछ सेकंड बाद फिर कोशिश करें।"

msgid "resets at %s"
msgstr "%s पर रीसेट"

msgid "%d percent"
msgstr "%d प्रतिशत"

msgid "no data"
msgstr "कोई डेटा नहीं"

msgid "reset"
msgstr "रीसेट हुआ"

